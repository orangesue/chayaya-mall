# 环境变量示例：复制为 .env 或直接在启动命令里设置
# 全部为可选项，不设置时使用默认值（本机演示无需任何配置）

# ---------- 服务 ----------
PORT=8788
# 默认 0.0.0.0（同一 WiFi 的手机可访问）；只想本机访问时改为 127.0.0.1
HOST=0.0.0.0
# 打印在溯源二维码里的站点地址。局域网演示用局域网 IP，上线后改成 https 域名
# PUBLIC_BASE_URL=https://your-domain.com

# ---------- 数据库 ----------
# sqlite（默认，零安装） | mysql
DB_DRIVER=sqlite
SQLITE_FILE=./data/chayaya.db
# DB_DRIVER=mysql 时生效
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chayaya

# ---------- 缓存 ----------
# memory（默认） | redis
CACHE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# ---------- 安全 ----------
# 生产环境务必改成随机长字符串
JWT_SECRET=change-me-in-production
# 一物一码 ECDSA 签名私钥种子（改了会导致历史溯源码签名失效）
TRACE_SIGN_SEED=chayaya-trace-ecdsa-seed

# ---------- 微信（拿到小程序后填写） ----------
# WX_APPID=wx****************
# WX_SECRET=****************

# ---------- AI 客服（可选，不填则使用内置规则引擎） ----------
# AI_API_KEY=sk-****************
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
